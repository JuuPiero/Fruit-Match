// Outer glow cho 2D Sprite
CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.5 }
        # Màu glow
        glowColor: {
          value: [1.0, 1.0, 0.0, 1.0],
          editor: {
            type: color,
            tooltip: "Màu glow"
          }
        }
        # Độ rộng glow (theo UV, 0.01 ~ 0.1 là đẹp)
        glowColorSize: {
          value: 0.06,
          editor: {
            tooltip: "Độ rộng glow",
            range: [0.0, 1.0],
          }
        }
        # Độ gắt của glow: nhỏ = viền sáng gắt, lớn = tỏa mềm
        glowThreshold: {
          value: 0.5,
          editor: {
            tooltip: "Độ gắt của glow",
            range: [0.0, 1.0]
          }
        }
        # Cường độ sáng: >1 glow rực và lõi trắng dần
        glowIntensity: {
          value: 2.0,
          editor: {
            tooltip: "Cường độ glow",
            range: [0.0, 5.0]
          }
        }
}%

CCProgram sprite-vs %{
  precision highp float;

  #include <builtin/uniforms/cc-global>

  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif

  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 v_color;
  out vec2 v_uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);

    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    v_uv0 = a_texCoord;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(v_uv0);
    #endif

    v_color = a_color;

    return pos;
  }
}%


CCProgram sprite-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>
  #include <builtin/uniforms/cc-global>

  in vec4 v_color;
  in vec2 v_uv0;

  #pragma builtin(local)
  layout(set = 2, binding = 11) uniform sampler2D cc_spriteTexture;

  #if SHOW_OUTTER_GLOW

  uniform glow {
    // vec4 phải khai báo trước float
    vec4 glowColor;
    float glowColorSize;
    float glowThreshold;
    float glowIntensity;
  };

  // Số hướng lấy mẫu trên mỗi vòng: càng nhiều viền càng tròn mượt
  #define GLOW_DIRECTIONS 16
  // Số vòng lấy mẫu từ tâm ra tới glowColorSize
  #define GLOW_RINGS 10

  // Ngoài biên texture coi như trong suốt (đồng nhất editor / trình duyệt)
  float getTextureAlpha(vec2 uv) {
    if (uv.x > 1.0 || uv.x < 0.0 || uv.y > 1.0 || uv.y < 0.0) {
      return 0.0;
    }
    return CCSampleWithAlphaSeparated(cc_spriteTexture, uv).a;
  }

  // Alpha trung bình của 1 vòng tròn bán kính dist quanh điểm hiện tại
  float getRingAverageAlpha(float dist) {
    float total = 0.0;
    for (int i = 0; i < GLOW_DIRECTIONS; i++) {
      float radian = 6.28318530718 * float(i) / float(GLOW_DIRECTIONS);
      total += getTextureAlpha(v_uv0 + vec2(dist * cos(radian), dist * sin(radian)));
    }
    return total / float(GLOW_DIRECTIONS);
  }

  // Độ "đặc" trung bình của vùng ảnh quanh điểm hiện tại trong bán kính glowColorSize:
  // điểm càng gần hình càng đặc -> glow càng sáng, xa dần thì tắt mượt
  float getGlowAlpha() {
    if (glowColorSize <= 0.0) {
      return 0.0;
    }

    float total = 0.0;
    for (int i = 1; i <= GLOW_RINGS; i++) {
      total += getRingAverageAlpha(glowColorSize * float(i) / float(GLOW_RINGS));
    }
    return total / float(GLOW_RINGS);
  }

  #endif

  vec4 frag () {
    vec4 o = vec4(1, 1, 1, 1);

    #if USE_TEXTURE
      o *= CCSampleWithAlphaSeparated(cc_spriteTexture, v_uv0);
    #endif

    #if SHOW_OUTTER_GLOW
      float occ = getGlowAlpha();

      // Chuẩn hóa theo threshold: chạm ngưỡng là sáng tối đa
      float a = clamp(occ / max(glowThreshold, 0.0001), 0.0, 1.0);

      // Rực sát mép sprite, đuôi tỏa dài dần ra ngoài
      a = 1.0 - pow(1.0 - a, 3.0);

      #if USE_PULSE
        // Nhấp nháy theo thời gian cho hiệu ứng highlight
        a *= 0.7 + 0.3 * sin(cc_time.x * 4.0);
      #endif

      float glowA = clamp(a * glowIntensity, 0.0, 1.0) * glowColor.a;

      // Cường độ cao thì lõi glow trắng dần cho cảm giác cháy sáng
      vec3 glowRGB = mix(glowColor.rgb, vec3(1.0), clamp((glowIntensity - 1.0) * 0.25, 0.0, 0.6) * a);

      // Ghép glow phía sau sprite theo alpha-over chuẩn (không nhân alpha 2 lần)
      float srcA = o.a;
      float dstA = glowA * (1.0 - srcA);
      float outA = srcA + dstA;

      o.rgb = (o.rgb * srcA + glowRGB * dstA) / max(outA, 0.0001);
      o.a = outA;
    #endif

    o *= v_color;
    ALPHA_TEST(o);

    return o;
  }
}%
